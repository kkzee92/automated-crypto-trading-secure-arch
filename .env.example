# Copy to .env and fill with your values
# NEVER commit .env

# Exchange credentials (trade-only keys, withdrawals DISABLED)
EXCHANGE_ID=binance
API_KEY=your_api_key_here
API_SECRET=your_api_secret_here

# Optional: password for some exchanges
# API_PASSWORD=

# Paper trading by default
PAPER_TRADING=true

# Risk parameters
MAX_POSITION_PCT=0.02
DEFAULT_STOP_LOSS_PCT=0.05
